<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4×2 "Thực đơn hôm nay". Chỉ tên món, bữa, kcal; không thuốc/bệnh (AC14c). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/meal_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/meal_widget_bg"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/meal_widget_chef" />

        <TextView
            android:id="@+id/meal_widget_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/meal_widget_button"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="@string/meal_widget_button"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/meal_widget_title"
            android:textColor="#FF1E2321"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/meal_widget_message"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/meal_widget_open_today"
            android:textColor="#FF00594F"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/meal_widget_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row_sang"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:background="@drawable/meal_widget_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/label_sang"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:text="@string/meal_widget_sang"
                    android:textColor="#FF5E6663"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/thumb_sang"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/meal_widget_dot_sang" />

                <TextView
                    android:id="@+id/name_sang"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/meal_widget_not_chosen"
                    android:textColor="#FF1E2321"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/kcal_sang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#FF5E6663"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_trua"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:background="@drawable/meal_widget_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/label_trua"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:text="@string/meal_widget_trua"
                    android:textColor="#FF5E6663"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/thumb_trua"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/meal_widget_dot_trua" />

                <TextView
                    android:id="@+id/name_trua"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/meal_widget_not_chosen"
                    android:textColor="#FF1E2321"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/kcal_trua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#FF5E6663"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_toi"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:background="@drawable/meal_widget_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/label_toi"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:text="@string/meal_widget_toi"
                    android:textColor="#FF5E6663"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/thumb_toi"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/meal_widget_dot_toi" />

                <TextView
                    android:id="@+id/name_toi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/meal_widget_not_chosen"
                    android:textColor="#FF1E2321"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/kcal_toi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#FF5E6663"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
