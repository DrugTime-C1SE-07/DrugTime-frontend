<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2×2: Dumi + bữa sắp tới (món đã chọn hoặc "Chưa chọn"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/meal_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/meal_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/meal_widget_chef" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/small_meal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/meal_widget_meal_trua"
        android:textColor="#FF00594F"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/small_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/meal_widget_not_chosen"
        android:textColor="#FF1E2321"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
