<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Thực đơn hôm nay": mặc định 4×2, co được tới 2×2. Không tự cập nhật theo chu kỳ:
     app đẩy dữ liệu khi chọn/bỏ chọn món; provider tự đối chiếu ngày giờ VN mỗi lần vẽ. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/meal_widget_description"
    android:initialLayout="@layout/meal_menu_widget"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewImage="@drawable/meal_widget_chef"
    android:previewLayout="@layout/meal_menu_widget"
    android:updatePeriodMillis="0" />
