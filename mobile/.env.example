# Cấu hình lúc build cho app mobile, dùng với: flutter run --dart-define-from-file=<file>
# Copy file này thành .env.android hoặc .env.web (đã có trong .gitignore) rồi sửa địa chỉ.
#
# Giá trị bị đóng vào app khi build, ai có file app cũng đọc được:
# chỉ ghi địa chỉ Backend API, KHÔNG ghi key hay secret (kể cả key Supabase).
#
# Địa chỉ thường dùng:
#   Android emulator:                 http://10.0.2.2:8000
#   Chrome (backend bật CORS cổng 5000): http://127.0.0.1:8001
#   Điện thoại thật qua adb reverse:  http://127.0.0.1:8000
DRUGTIME_API_BASE_URL=http://10.0.2.2:8000
